<?php
session_start();

$db = new mysqli('localhost', 'root', '', 'Twarzoblok');
if ($db->connect_error) {
    die("Błąd połączenia: " . $db->connect_error);
}

$msg = "";

if (isset($_POST['country'], $_POST['state'], $_POST['postal_code'], $_POST['municipality'], $_POST['city'], $_POST['street'], $_POST['house_number'])) {

    if (!isset($_SESSION['email']) || empty($_SESSION['email'])) {
        die("Błąd: brak sesji.");
    }

    $email = $_SESSION['email'];

    $country = trim($_POST['country']);
    $state = trim($_POST['state']);
    $postal_code = trim($_POST['postal_code']);
    $municipality = trim($_POST['municipality']);
    $city = trim($_POST['city']);
    $street = trim($_POST['street']);
    $house_number = trim($_POST['house_number']);

    if (empty($country) || empty($city) || empty($street) || empty($house_number) || empty($postal_code)) {
        $msg = "Wypełnij wymagane pola (kraj, miasto, ulica, nr domu, kod pocztowy).";
    } else {

        $q = $db->prepare("SELECT user_id FROM users WHERE email = ?");
        $q->bind_param("s", $email);
        $q->execute();
        $res = $q->get_result();

        if ($res->num_rows === 0) {
            die("Nie ma takiego użytkownika.");
        }

        $user = $res->fetch_assoc();
        $uid = $user['user_id'];
        $q->close();

        $u1 = $db->prepare("UPDATE users SET city = ? WHERE user_id = ?");
        $u1->bind_param("si", $city, $uid);

        $u2 = $db->prepare("INSERT INTO addresses (user_id, country, state, postal_code, municipality, city, street, house_number) VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
        $u2->bind_param("isssssss", $uid, $country, $state, $postal_code, $municipality, $city, $street, $house_number);

        if ($u1->execute() && $u2->execute()) {
            $msg = "Zapisano pomyślnie.";
        } else {
            $msg = "Wystąpił błąd podczas zapisu.";
        }

        $u1->close();
        $u2->close();
    }
}
