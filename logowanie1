<?php
session_start();

$db = new mysqli('localhost', 'root', '', 'Twarzoblok');
if ($db->connect_error) {
    die("Błąd połączenia: " . $db->connect_error);
}

if (isset($_POST['last_name'], $_POST['username'], $_POST['password'], $_POST['email'], $_POST['phone'], $_POST['first_name'], $_POST['dob'], $_POST['gender'], $_POST['avatar_url'], $_POST['bio'], $_POST['privacy_level'])) {

    $dob = $_POST['dob'];
    $bday = new DateTime($dob);
    $today = new DateTime();

    if ($today->diff($bday)->y < 13) {
        die("Błąd: Musisz mieć min. 13 lat.");
    }

    $phone = $_POST['phone'];
    if (!empty($phone)) {
        if (!preg_match('/^[0-9]{1,9}$/', $phone)) {
            die("Błąd: Zły numer telefonu.");
        }
    } else {
        $phone = null;
    }

    $city = 'Default City';
    $user = $_POST['username'];
    $pass = password_hash($_POST['password'], PASSWORD_DEFAULT);
    $email = $_POST['email'];
    $fname = $_POST['first_name'];
    $lname = $_POST['last_name'];
    $gender = $_POST['gender'];
    $avatar = $_POST['avatar_url'];
    $bio = $_POST['bio'];
    $priv = $_POST['privacy_level'];

    $stmt = $db->prepare("INSERT INTO users (last_name, username, password_hash, email, phone, first_name, dob, gender, avatar_url, bio, city, privacy_level) VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?)");
    $stmt->bind_param("ssssssssssss", $lname, $user, $pass, $email, $phone, $fname, $dob, $gender, $avatar, $bio, $city, $priv);

    if ($stmt->execute()) {
        $_SESSION['email'] = $email;
        $stmt->close();
        $db->close();
        header('Location: logowanie2.php');
        exit();
    } else {
        echo "Błąd: " . $stmt->error;
    }

    $stmt->close();
}
$db->close();
?>
